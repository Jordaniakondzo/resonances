{
  "name": "resonances",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build:web": "next build",
    "start": "next start",
    "typecheck:web": "next typegen && tsc --noEmit -p tsconfig.web.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:web",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "format:check": "prettier --check --end-of-line auto \"db/*.ts\" \"src/**/*.{ts,tsx,css}\" tests scripts drizzle.config.ts next.config.ts tsconfig.json tsconfig.web.json package.json",
    "db:verify": "tsx scripts/verify-schema.ts",
    "test:editorial": "tsx --test tests/editorial.test.ts",
    "check:client-bundle": "tsx scripts/check-client-bundle.ts",
    "test:web-boundaries": "tsx --test tests/web-boundaries.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "mdast-util-from-markdown": "2.0.3",
    "next": "16.4.5",
    "pg": "8.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
