{
  "name": "resonances",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate.ts",
    "format:check": "prettier --check \"db/*.ts\" \"src/**/*.ts\" tests scripts drizzle.config.ts tsconfig.json package.json",
    "db:verify": "tsx scripts/verify-schema.ts",
    "test:editorial": "tsx --test tests/editorial.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "mdast-util-from-markdown": "2.0.3",
    "pg": "8.23.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
